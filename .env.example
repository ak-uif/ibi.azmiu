# Local database examples only. Never put real secrets here.
DB_URL=jdbc:postgresql://localhost:5432/ibi
DB_USERNAME=your_local_postgres_user
DB_PASSWORD=replace_locally

# Initial admin only; set real values in the ignored local .env file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_locally

# Public frontend setting (not a secret). Local development only.
VITE_API_BASE_URL=http://localhost:8080
# Optional: comma-separated trusted frontend origins for credentialed CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
